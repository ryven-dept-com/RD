# --- Required -----------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Optional -----------------------------------------------------------
# Public base URL of the storefront, used by Admin → Products to generate
# public product links ({SITE_BASE_URL}/products/{slug}).
# Production value for this deployment: https://ryven-com-ten.vercel.app
# (set it in the hosting environment, e.g. Vercel → Project → Settings →
# Environment Variables). Leave unset locally — the current origin is used.
NEXT_PUBLIC_SITE_URL=
