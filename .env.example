# --- Required -----------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Optional -----------------------------------------------------------
# Public base URL of the storefront, used by Admin → Products to generate
# public product links ({SITE_BASE_URL}/products/{slug}).
# Production value for this deployment: https://ryven-com-ten.vercel.app
# (set it in the hosting environment, e.g. Vercel → Project → Settings →
# Environment Variables). Leave unset locally — the current origin is used.
NEXT_PUBLIC_SITE_URL=

# --- Private mobile admin app: push notifications (optional) ------------
# Firebase Cloud Messaging delivers "New Order" alerts to the registered
# admin device. SERVER-SIDE ONLY — these values must never be shipped in
# any client bundle (web or Android). Configure at most ONE provider:
#
# Preferred — FCM HTTP v1 service account JSON (Firebase Console →
# Project settings → Service accounts → Generate new private key), pasted
# as a single line:
FCM_SERVICE_ACCOUNT_JSON=
#
# Alternative — legacy FCM server key (Firebase Console → Project settings
# → Cloud Messaging → Server key):
FCM_SERVER_KEY=
#
# When neither is set, notifications are still recorded and visible in the
# admin app's in-app notification history; push delivery is skipped.
