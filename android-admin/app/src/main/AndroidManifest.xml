<?xml version="1.0" encoding="utf-8"?>
<!--
  RYVEN DEPT — PRIVATE ADMIN APP.
  - No guest access: every screen requires the admin session.
  - HTTPS only (cleartext disabled).
  - Push notifications go to the registered admin device only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AdminApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RyvenAdmin"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- exported=false: reachable only from inside the app (including
             the notification PendingIntent, which carries our own intent). -->
        <activity
            android:name=".OrderDetailsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- FCM message handler (admin push notifications). -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
